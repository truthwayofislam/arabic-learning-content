    {
      "id": "basic-alphabet-01",
      "order": 1,
      "title": {
        "en": "Letters 1: Alif to Khāʾ",
        "ur": "حروف ۱: الف سے خاء تک",
        "id": "Huruf 1: Alif sampai Khā",
        "tr": "Harfler 1: Elif'ten Hı'ya",
        "fr": "Lettres 1 : Alif à khā"
      },
      "objective": {
        "en": "Recognize the first seven Arabic letters, say their names, and notice how their shapes connect.",
        "ur": "عربی کے پہلے سات حروف پہچانیں، ان کے نام بولیں، اور دیکھیں کہ ان کی شکلیں کیسے جڑتی ہیں۔",
        "id": "Kenali tujuh huruf Arab pertama, ucapkan namanya, dan perhatikan cara bentuknya tersambung.",
        "tr": "İlk yedi Arap harfini tanıyın, adlarını söyleyin ve şekillerinin nasıl birleştiğine dikkat edin.",
        "fr": "Reconnaissez les sept premières lettres arabes, dites leur nom et observez comment leurs formes se lient."
      },
      "instruction": {
        "en": "Read from right to left. Listen to the Arabic letter name and example, then repeat.",
        "ur": "دائیں سے بائیں پڑھیں۔ عربی حرف اور مثال سنیں، پھر دہرائیں۔",
        "id": "Baca dari kanan ke kiri. Dengarkan nama huruf dan contohnya dalam bahasa Arab, lalu ulangi.",
        "tr": "Sağdan sola okuyun. Harfin ve örneğinin Arapça okunuşunu dinleyip tekrarlayın.",
        "fr": "Lisez de droite à gauche. Écoutez le nom arabe de la lettre et l'exemple, puis répétez."
      },
